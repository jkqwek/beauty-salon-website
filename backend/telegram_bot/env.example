# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git — добавьте его в .gitignore!

# Токен, полученный от @BotFather
BOT_TOKEN=123456:ABC-DEF_ваш_реальный_токен

# chat_id администратора или группы, куда слать уведомления о новых записях.
# Узнать свой chat_id можно, написав боту @userinfobot
ADMIN_CHAT_ID=123456789
